generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  role        String   @default("EMPLOYEE")
  team        String?
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager         User?          @relation("TeamManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees       User[]         @relation("TeamManager")
  managedProjects Project[]      @relation("ProjectManager")
  assignedTasks   Task[]
  timeEntries     TimeEntry[]
  notifications   Notification[]
  gitCommits      GitCommit[]    @relation("GitCommitUser")
}

model Project {
  id                    String   @id @default(uuid())
  projectName           String
  description           String?
  status                String   @default("ACTIVE")
  managerId             String?
  externalClickUpListId String?
  gitRepositoryUrl      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks            Task[]
  timeEntries      TimeEntry[]
  clickUpTaskLinks ClickUpTaskLink[] @relation("ClickUpTaskProject")
}

model Task {
  id             String   @id @default(uuid())
  taskName       String
  description    String?
  projectId      String
  assignedUserId String?
  status         String   @default("TODO")
  priority       String   @default("MEDIUM")
  clickUpTaskId  String?
  estimatedHours Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedUser User?       @relation(fields: [assignedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  timeEntries  TimeEntry[]
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model TimeEntry {
  id                   String   @id @default(uuid())
  userId               String
  projectId            String
  taskId               String
  date                 DateTime
  startTime            DateTime
  endTime              DateTime
  durationMinutes      Int
  workType             String   @default("DEVELOPMENT")
  description          String?
  source               String   @default("MANUAL")
  status               String   @default("DRAFT")
  relatedCommitHash    String?
  relatedClickUpTaskId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model GitCommit {
  id                String   @id @default(uuid())
  commitHash        String   @unique
  repository        String
  branch            String?
  commitMessage     String
  authorEmail       String
  authorName        String
  commitDate        DateTime
  linkedUserId      String?
  linkedTaskId      String?
  linkedTimeEntryId String?
  createdAt         DateTime @default(now())

  linkedUser User? @relation("GitCommitUser", fields: [linkedUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ClickUpTaskLink {
  id             String    @id @default(uuid())
  clickUpTaskId  String    @unique
  taskName       String
  description    String?
  projectId      String?
  assignedUserId String?
  status         String?
  estimatedTime  Int?
  dueDate        DateTime?
  lastSyncDate   DateTime  @default(now())
  createdAt      DateTime  @default(now())

  project Project? @relation("ClickUpTaskProject", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
